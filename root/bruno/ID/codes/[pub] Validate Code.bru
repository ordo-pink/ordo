meta {
  name: [pub] Validate Code
  type: http
  seq: 1
}

post {
  url: {{ID_HOST}}/codes/validate?Origin={{ORIGIN}}
  body: json
  auth: none
}

params:query {
  Origin: {{ORIGIN}}
}

headers {
  Origin: {{ORIGIN}}
}

body:json {
  {
    "email": "{{USER_EMAIL}}",
    "code": "{{CURRENT_CODE}}"
  }
}

script:post-response {
  bru.setVar("CURRENT_ID", res.getBody().payload.id)
  bru.setVar("CURRENT_EMAIL", res.getBody().payload.email)
  bru.setVar("CURRENT_HANDLE", res.getBody().payload.handle)
  
}
